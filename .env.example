# Hotseat Monorepo Environment Variables
# Copy this to .env and replace placeholder values.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual credentials

# --- PostgreSQL Database ---
DB_USER=hotseat_admin
DB_HOST=localhost
DB_NAME=hotseat_db
DB_PASSWORD=change_this
DB_PORT=5432

# --- VAPID Keys (Web Push Notifications) ---
# Generate at: https://vapidkeys.com or via `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=admin@yourdomain.com

# --- CORS ---
# The origin your frontend is served from (no trailing slash).
CORS_ORIGIN=https://yourdomain.com

# --- Server ---
SERVER_PORT=5000

# --- Frontend (Vite, prefixed with VITE_) ---
VITE_SERVER_URL=https://yourdomain.com

# --- GIPHY API Key (optional, for GIF search in chat) ---
# Get one at: https://developers.giphy.com
VITE_GIPHY_KEY=your_giphy_api_key

# --- VAPID Public Key (must match backend) ---
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key